{
  "productName": "Ombracrypt",
  "version": "1.0.0",
  "identifier": "com.abiswasdev.ombracrypt",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Ombracrypt 1.0.0",
        "width": 500,
        "height": 860, 
        "minWidth": 500,
        "minHeight": 860,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default-capabilities",
          "windows": ["*"],
          "permissions": [
            "core:default",
            "dialog:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "The zero-trust quantum vault.",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}