{
  "productName": "Ombracrypt",
  "version": "1.1.0",
  "identifier": "com.abiswasdev.ombracrypt",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Ombracrypt 1.1.0",
        "width": 540,
        "height": 760,
        "minWidth": 500,
        "minHeight": 700,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
      "capabilities": [
        {
          "identifier": "default-capabilities",
          "windows": ["*"],
          "permissions": [
            "core:default",
            "dialog:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "The zero-trust post-quantum vault.",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}